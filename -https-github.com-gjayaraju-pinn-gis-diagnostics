2. PINN Training Scripts (Python/PyTorch)
The repository contains a main training script train_pinn.py that implements the forward and inverse PINN described in Section 5 of the paper. Below we show the core structure and key functions.

2.1 Network Definition
python
import torch
import torch.nn as nn

class PINN(nn.Module):
    def __init__(self, layers=[3, 256, 256, 256, 256, 256, 256, 1]):
        super(PINN, self).__init__()
        self.activation = nn.Tanh()
        self.layers = nn.ModuleList()
        for i in range(len(layers)-1):
            self.layers.append(nn.Linear(layers[i], layers[i+1]))
        # Physical parameters as trainable scalars
        self.E_a = nn.Parameter(torch.tensor(1.0, dtype=torch.float32))   # MJ
        self.eta = nn.Parameter(torch.tensor(0.35, dtype=torch.float32))
        self.r_arc = nn.Parameter(torch.tensor(0.04, dtype=torch.float32)) # m

    def forward(self, r, z, t):
        # concatenate inputs
        x = torch.cat([r, z, t], dim=1)
        for i, layer in enumerate(self.layers[:-1]):
            x = self.activation(layer(x))
        x = self.layers[-1](x)
        return x
2.2 Loss Functions (PDE residual, data fidelity, boundary conditions)
python
def pde_loss(model, r, z, t, rho, cp, k, r_arc, eta, E_a, tau_arc, r0, z0):
    # Automatic differentiation
    T = model(r, z, t)
    T_t = torch.autograd.grad(T, t, grad_outputs=torch.ones_like(T), create_graph=True)[0]
    T_r = torch.autograd.grad(T, r, grad_outputs=torch.ones_like(T), create_graph=True)[0]
    T_rr = torch.autograd.grad(T_r, r, grad_outputs=torch.ones_like(T_r), create_graph=True)[0]
    T_zz = torch.autograd.grad(T, z, grad_outputs=torch.ones_like(T), create_graph=True)[0]
    
    # Source term
    Q = (eta * E_a) / (torch.pi * r_arc**2 * L * tau_arc) * \
        torch.exp(-((r - r0)**2 + (z - z0)**2) / (2 * r_arc**2))
    
    # PDE residual
    residual = rho * cp * T_t - k * (T_rr + (1/r)*T_r + T_zz) - Q
    return torch.mean(residual**2)

def data_loss(model, r_obs, z_obs, t_obs, T_meas):
    T_pred = model(r_obs, z_obs, t_obs)
    return torch.mean((T_pred - T_meas)**2)

def bc_loss(model, r_bc, z_bc, t_bc, h_conv, eps, sigma, T_amb, k):
    T = model(r_bc, z_bc, t_bc)
    T_r = torch.autograd.grad(T, r_bc, grad_outputs=torch.ones_like(T), create_graph=True)[0]
    # Outer boundary: -k * dT/dr = h_conv*(T - T_amb) + eps*sigma*(T^4 - T_amb^4)
    residual_bc = -k * T_r - (h_conv*(T - T_amb) + eps*sigma*(T**4 - T_amb**4))
    return torch.mean(residual_bc**2)
